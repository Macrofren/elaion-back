PROJECT_NAME="FastAPI Enterprise Boilerplate"
API_V1_STR="/api/v1"
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=elaion_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/elaion_db
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# OBRIGATÓRIO: chave de assinatura JWT (mín. 32 caracteres, forte e única).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-uma-chave-forte-e-unica-de-no-minimo-32-caracteres
